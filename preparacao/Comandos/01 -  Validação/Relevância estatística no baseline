SELECT
    g.grupo,
    COUNT(DISTINCT d.driver_uuid)              AS n,
    ROUND(AVG(d.pedidos::NUMERIC), 3)          AS pedidos,
    ROUND(AVG(d.supply_hours::NUMERIC), 3)     AS supply_hours,
    ROUND(AVG(d.worked_hours::NUMERIC), 3)     AS worked_hours,
    ROUND(AVG(d.ganho_total::NUMERIC), 2)      AS ganho_total,
    ROUND(AVG(d.ganho_promocao::NUMERIC), 2)   AS ganho_promo
FROM dados_entregadores d
JOIN grupos_entregadores g ON g.driver_uuid = d.driver_uuid
WHERE d.week::DATE < DATE '2026-06-01'
GROUP BY g.grupo;
